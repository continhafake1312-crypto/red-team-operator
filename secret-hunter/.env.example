# ── Secret Hunter Configuration ──────────────────────────────────────────
# Copie para .env e edite

# GitHub Tokens (separados por vírgula) — OBRIGATÓRIO para scans reais
# Gere em: https://github.com/settings/tokens (precisa de: repo, user, gist)
GITHUB_TOKENS="ghp_yourtoken1here,ghp_yourtoken2here"

# Data mínima para filtrar keys (YYYY-MM-DD)
SCANNER_MIN_DATE="2026-01-01"

# Modo de scan: "both" | "code" | "commits"
SCAN_MODE="both"

# Dashboard
DASHBOARD_HOST="0.0.0.0"
DASHBOARD_PORT="8080"

# Validação
VALIDATION_TIMEOUT="10"
VALIDATION_MAX_WORKERS="10"