# Secret Hunter — Config
# Copie para .env e edite

# GitHub tokens (separados por vírgula) — OBRIGATÓRIO para scans reais
# Gere em: https://github.com/settings/tokens (scopes: repo, user, gist)
GITHUB_TOKENS="ghp_seutoken1,ghp_seutoken2"

# Data mínima para filtrar keys (YYYY-MM-DD)
SCANNER_MIN_DATE="2026-01-01"

# Dashboard
DASHBOARD_HOST="0.0.0.0"
DASHBOARD_PORT="8080"