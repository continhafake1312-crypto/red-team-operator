                <script type="text/javascript" src="/js/jquery.validate.min.js"></script>
                <script type="text/javascript">
                    $(document).ready(function(){
                        $('#home-newsletter').validate({
                            onfocusout: false,
                            onkeyup: false,
                            rules: {
                                email: {email: true},
                            },
                            showErrors: function(errorMap, errorList) {
                                if (errorMap.email) {
                                    $('.response').html('<p>Preencha todos os campos corretamente!</p>');
                                };
                                console.log(errorList);
                            },

                            submitHandler: function(form) {
                                var nome = $('#nome').val();
                                var email = $('#email').val();

                                var response = $('.response');

                                if (!nome || !email) {

                                    response.html('Preencha todos os campos.');

                                } else {

                                    response.fadeOut();
                                    $('#home-newsletter-enviar').text('Enviando...');
                                    $('#home-newsletter-enviar').attr('disabled','disabled');

                                    $.ajax({
                                        url: "/contato/newsletter",
                                        type: "post",
                                        dataType: "json",
                                        data: {nome: nome, email: email},
                                    })
                                    .done(function(ret) {

                                        if (ret.success == true) {
                                            response.html('<p>'+nome+', seu cadastro foi realizado com sucesso!</p>');
                                            $('#home-newsletter').get(0).reset();
                                        } else {
                                            response.html('<p>Erro ao realizar seu cadastro!</p>');
                                        }
                                        response.fadeIn();
                                        $('#home-newsletter-enviar').text('Enviar');
                                        $('#home-newsletter-enviar').removeAttr('disabled');
                                    });
                                    
                                };

                            }
                        });
                    });
                </script>


