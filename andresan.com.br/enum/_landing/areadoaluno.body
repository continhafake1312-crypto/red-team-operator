    <section class="encontre-curso">
        <div class="container">
            <div class="row">
                <div class="col-xs-12 title">
                    <h2>Encontre o curso ideal</h2>
                    <hr>
                    <p>Você pode buscar pela informação que desejar</p>
                </div>
                <form action="/busca" method="get">
                    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 form-group">
                        <input type="text" class="form-control" id="curso_nome" name="s" placeholder="BUSCA POR NOME">
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 form-group">
                        <input type="text" class="form-control" id="curso_concurso" name="concurso" placeholder="BUSCA PELO CONCURSO">
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 form-group">
                        <input type="text" class="form-control" id="curso_categoria" name="categoria" placeholder="BUSCAR PELA CATEGORIA">
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 form-group">
                        <input type="text" class="form-control" id="curso_professor" name="professor" placeholder="BUSCAR POR PROFESSOR">
                    </div>
                    <div class="col-xs-12">
                        <button class="center-block btn btn-danger">Buscar Curso</button>   
                        <p class="text-center">
                            <a href="/cursos">Ou veja os nossos cursos</a>
                        </p>
                    </div>
                    <script type="text/javascript">
                        $(document).ready(function(){
                            
                            $("#curso_nome").autocomplete({ source: ["Assinatura de L\u00edngua Portuguesa - 2023 - Pr\u00e9-lan\u00e7amento","Assinatura Total - 2022 - On-line","Degusta\u00e7\u00e3o - CESPE\/Cebraspe - Resolu\u00e7\u00e3o de Quest\u00f5es","Degusta\u00e7\u00e3o - FCC - Resolu\u00e7\u00e3o de Quest\u00f5es","Degusta\u00e7\u00e3o - Fundatec - Resolu\u00e7\u00e3o de Quest\u00f5es","Degusta\u00e7\u00e3o - Interpreta\u00e7\u00e3o de Textos","Degusta\u00e7\u00e3o - Legalle - Resolu\u00e7\u00e3o de Quest\u00f5es","Degusta\u00e7\u00e3o - Portugu\u00eas Avan\u00e7ado","Degusta\u00e7\u00e3o - Portugu\u00eas Extensivo On-Line - Completo","Degusta\u00e7\u00e3o - Portugu\u00eas Intensivo","FUNDATEC - Portugu\u00eas - Resolu\u00e7\u00e3o de Quest\u00f5es - On-line","PCRS - Escriv\u00e3o e Inspetor - Curso Especial","TRT-RS - Aul\u00e3o da Aprova\u00e7\u00e3o - PRESENCIAL (Ingresso \u00danico)"]                            , minLenght: 0}).focus(function(){ $(this).autocomplete("search", " "); });
                            $("#curso_concurso").autocomplete({ source: [], minLenght: 0}).focus(function(){ $(this).autocomplete("search", " "); });
                            $("#curso_categoria").autocomplete({ source: null, minLenght: 0}).focus(function(){ $(this).autocomplete("search", " "); });
                            $("#curso_professor").autocomplete({ source: ["Aldo Jo\u00e3o do Amaral Pereira ","Alessandra Vieira ","Alexei Muller ","Aline Doval ","Andresan Machado ","Angie Finkler ","Bruno Guimar\u00e3es ","Bruno Soper ","Carolina Fernandes ","Christian Azevedo ","Christian Nedel ","Cristiano de Souza ","Cristiny Mroczkoski Rocha ","Daniel Topanotti ","Daniela Arboite ","Davi Andr\u00e9 ","Diego Degrazia ","F\u00e1bio Maia ","Fabr\u00edcio Aita ","Felipe Faoro Bertoni ","Felipe Pimentel ","Fernanda Borghetti ","Fernando Aprato ","Franciele Rieffel ","Gustavo Tanger Jardim ","Gustavo Vieira ","Isabel Trevisan ","Jayme Camargo ","Jeferson Luiz Dellavalle Dutra ","Joerberth Nunes ","Jorge Bart ","Jorge Pastor ","Jos\u00e9 Wesley ","Juliano Heinen ","Juliano Viegas ","Karine Migliavacca ","Leandro Roitman ","Let\u00edcia Loureiro ","Let\u00edcia Neves ","Lucas Ruano ","Marcello Giulian ","Marcelo Spilki ","Marcelo Xavier ","M\u00e1rcia Bet\u00e2nia ","Mariana Secorun In\u00e1cio ","Mari\u00e2ngela Milhoranza ","Martha Messerschmidt ","Mateus Silveira ","Mozarth Wierzchowski ","Newton Jancowski ","Patr\u00edcia Strauss ","Paulo Marques ","Pedro Kuhn ","Rafael Jaques Jardim ","Rafael Ravazolo ","Raquel Peruzzo ","Ricardo Conzatti ","Rodrigo Schaeffer ","Silvana Fl\u00f4res ","Simone Schroeder ","Susanna Schwantes ","Ta\u00eds Flores ","Tatiana Bastos ","Todos ","Ubirajara Martell Soares ","Vanessa Duarte Oliveira ","Wendell L\u00e9o ","Yuri Schneider "], minLenght: 0}).focus(function(){ $(this).autocomplete("search", " "); });
