tent="Focus Concursos"/><meta name="robots" content="index, follow"/><meta name="googlebot" content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"/><link rel="canonical" href="https://focusconcursos.com.br"/><link rel="alternate" hrefLang="pt" href="https://focusconcursos.com.br"/><meta property="og:title" content="Focus Concursos"/><meta property="og:description" content="Estude com quem é referência em aprovação. O Focus Concursos oferece cursos online completos, videoaulas e materiais em PDF para carreiras policiais, tribunais e administrativas. Comece hoje sua jornada rumo à posse!"/><meta property="og:url" content="https://focusconcursos.com.br"/><meta property="og:image" content="https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/logo/cltvvcc500737z7qn9lsd02vv.png"/><meta property="og:image:width" content="800"/><meta property="og:image:height" content="600"/><meta property="og:image:alt" content="Focus Concursos"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content="Focus Concursos"/><meta name="twitter:description" content="Estude com quem é referência em aprovação. O Focus Concursos oferece cursos online completos, videoaulas e materiais em PDF para carreiras policiais, tribunais e administrativas. Comece hoje sua jornada rumo à posse!"/><meta name="twitter:image" content="https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/logo/cltvvcc500737z7qn9lsd02vv.png"/><meta name="twitter:image:width" content="800"/><meta name="twitter:image:height" content="600"/><meta name="twitter:image:alt" content="Focus Concursos"/><link rel="icon" href="https://focusconcursos.com.br/favicon.ico"/><script >document.querySelectorAll('body link[rel="icon"], body link[rel="apple-touch-icon"]').forEach(el => document.head.appendChild(el))</script><div hidden id="S:0"></div><script>$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.parentNode&&e.parentNode.removeChild(e);var f=c.parentNode;if(f){var g=c.previousSibling,h=0;do{if(c&&8===c.nodeType){var d=c.data;if("/$"===d||"/&"===d)if(0===h)break;else h--;else"$"!==d&&"$?"!==d&&"$~"!==d&&"$!"!==d&&"&"!==d||h++}d=c.nextSibling;f.removeChild(c);c=d}while(c);for(;e.firstChild;)f.insertBefore(e.firstChild,c);g.data="$";g._reactRetry&&requestAnimationFrame(g._reactRetry)}}a.length=0};
$RC=function(a,b){if(b=document.getElementById(b))(a=document.getElementById(a))?(a.previousSibling.data="$~",$RB.push(a,b),2===$RB.length&&("number"!==typeof $RT?requestAnimationFrame($RV.bind(null,$RB)):(a=performance.now(),setTimeout($RV.bind(null,$RB),2300>a&&2E3<a?2300-a:$RT+300-a)))):b.parentNode.removeChild(b)};$RC("B:0","S:0")</script><script>self.__next_f.push([1,"2f:I[39821,[\"66711\",\"static/chunks/8e1d74a4-df0199328e47a178.js\",\"85105\",\"static/chunks/0e5ce63c-a1ecb5a6f4ebd24d.js\",\"18720\",\"static/chunks/18720-e3c0395591d5c9b9.js\",\"81356\",\"static/chunks/81356-30de98b0caebd8c9.js\",\"70760\",\"static/chunks/70760-5bb4a642a221da43.js\",\"67311\",\"static/chunks/67311-d2973c86b5bf60bc.js\",\"52619\",\"static/chunks/52619-e74ceb3268467e30.js\",\"95084\",\"static/chunks/95084-627e88d5373613d7.js\",\"55352\",\"static/chunks/55352-ae0ae1711770b24d.js\",\"74677\",\"static/chunks/74677-17e73e1da87bdd8e.js\",\"93737\",\"static/chunks/93737-006c83d2c959e401.js\",\"15279\",\"static/chunks/15279-b87111f50360a140.js\",\"61535\",\"static/chunks/61535-804901ead2bac128.js\",\"26852\",\"static/chunks/26852-fd74dae327a79b21.js\",\"97955\",\"static/chunks/97955-273eef41f6233fce.js\",\"32082\",\"static/chunks/32082-535880de626385fd.js\",\"60213\",\"static/chunks/60213-052504d9149068f5.js\",\"90581\",\"static/chunks/90581-834a5b152c5a42d4.js\",\"27604\",\"static/chunks/27604-df9f1531f8d735c7.js\",\"4959\",\"static/chunks/4959-b0acad4f8c90efc1.js\",\"15411\",\"static/chunks/app/%5Bdomain%5D/(ecommerce)/page-0a9fc8705b33be53.js\"],\"TestimonialsClient\"]\n"])</script><script>self.__next_f.push([1,"30:T51a,"])</script><script>self.__next_f.push([1,"\u003cp\u003eEstamos aqui acompanhando o blog Focos com dois aprovados, Rodrigo Ferreira e Daniel Schneider, no concurso da Polícia Federal. A conversa é informal, sem roteiro prévio, sobre a preparação deles e como se sentiram durante o processo.\u003c/p\u003e\u003cp\u003eRodrigo destaca que a preparação foi desafiadora, trabalhando 24 horas em alguns dias, mas a dedicação era constante, ajustando o estudo conforme sua disposição. Ele enfatiza a importância de não deixar de estudar nenhuma matéria, mesmo aquelas menos preferidas, como o Português.\u003c/p\u003e\u003cp\u003eDaniel ressalta que o concurso é um sonho realizado para muitos, mas a reprovação pode ser um impacto difícil. Ele aconselha a valorizar o dia da aprovação e não desanimar diante das dificuldades.\u003c/p\u003e\u003cp\u003eAmbos compartilham a importância de focar nas matérias essenciais, mesmo aquelas menos gostosas, e como as surpresas na prova podem ocorrer. Destacam o valor de manter a disciplina, inclusive na parte física, para manter a concentração nos estudos.\u003c/p\u003e\u003cp\u003eNa conversa, eles também mencionam que, apesar de cada um ter sua trajetória, o apoio e a motivação mútua entre colegas de estudo são fundamentais. Encerram com uma mensagem de encorajamento para quem continua se preparando, incentivando a persistência e a busca pelos objetivos.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"31:T42d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eParticipei do meu primeiro concurso para a polícia militar, inicialmente estudando sozinho, sem orientação, e não obtive aprovação. Após essa tentativa, percebi a necessidade de auxílio qualificado e, a partir de 2015, iniciei meus estudos com o Focus Concursos.\u003c/p\u003e\u003cp\u003eConquistei aprovações no Tribunal de Justiça do Estado de São Paulo, na polícia civil do Mato Grosso do Sul e na polícia penal do mesmo estado, onde atualmente exerço cargo. Obtive diversas aprovações, incluindo polícia penal e militar de Santa Catarina, além da polícia civil de São Paulo. Essa jornada mudou minha vida, proporcionando estabilidade, uma boa residência, carro e condição financeira.\u003c/p\u003e\u003cp\u003eDestaco a satisfação geral dos colegas no serviço público, seja em tribunais, órgãos governamentais, prefeituras ou no serviço público federal. O serviço público oferece estabilidade, respeito na sociedade e uma carreira gratificante. Encorajo todos a iniciarem imediatamente sua preparação, sem perder tempo, traçando objetivos e focando nos sonhos.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"2d:[[\"$\",\"$L23\",null,{\"moduleIds\":[\"components/sections/Testimonials.tsx -\u003e ./TestimonialsClient\"]}],[\"$\",\"$L2f\",null,{\"data\":[{\"id\":38,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"João Pedro de Faria\",\"legend\":\"MPSP,1º lugar no CSS do IBGE\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cltxdouaw000xvmqn6a1852ii.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cltxdoufe000yvmqne8qbf3ut.webp\",\"video\":\"9BowXA7B4mg\",\"message\":\"\u003cp\u003eConheci o Focus ao adquirir o curso de reta final, buscando uma opção rápida. O que me atraiu foi o material escrito, complementando as videoaulas. Destaque para a didática envolvente dos professores, como Franco, cujas aulas são animadas e motivadoras. A extensão do material escrito é adequada, e a metodologia de ter as aulas em formato de vídeo ao lado do PDF é excelente. A plataforma atualizada facilita a navegação, marcando aulas já assistidas e oferecendo agilidade. Destaco a funcionalidade de marcar aulas para revisão, auxiliando na organização do estudo para concursos.\u003c/p\u003e\",\"phone\":null,\"instagram\":null,\"city\":null,\"state\":null,\"highlighted\":1,\"slug\":\"joao-pedro-de-faria-2\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-02-28T14:10:19.000+00:00\",\"updated_at\":\"2024-02-28T14:10:19.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":45,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"Saulo de Andrade Silva Soares\",\"legend\":\"Aprovado PMSP\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cmf2njeg9001aqiqn88a785q1.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cmf4dceug00ivitqndsdw4lql.webp\",\"video\":\"haHIKyTHYm8\",\"message\":\"\u003cp\u003e...\u003c/p\u003e\",\"phone\":null,\"instagram\":null,\"city\":\"São Paulo\",\"state\":\"SP\",\"highlighted\":1,\"slug\":\"saulo-de-andrade-silva-soares\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2025-09-02T14:36:54.000+00:00\",\"updated_at\":\"2025-09-03T19:27:04.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":42,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"Ricardo Vieira Oviedo\",\"legend\":\"Polícia Penal Federal\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cmf2n2vpu000pqiqnbfidb61y.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cmf2n2vlj000oqiqnf1j73d7n.webp\",\"video\":\"g0HwA5awk5c\",\"message\":null,\"phone\":null,\"instagram\":null,\"city\":\"Cascavel\",\"state\":\"PR\",\"highlighted\":1,\"slug\":\"ricardo-vieira-oviedo\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2025-09-02T14:24:03.000+00:00\",\"updated_at\":\"2025-09-02T14:24:03.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":41,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"TAINA LAZARINI OLIVEIRA\",\"legend\":\"Escrivã PC-PR\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cmf2mpli9000fqiqnahwn4xux.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cmf2mn9ae000cqiqnc3pgev5c.webp\",\"video\":\"icNS76SOccU\",\"message\":null,\"phone\":\"4599112616\",\"instagram\":\"tainalzoliveira@hotmail.com\",\"city\":\"CASCAVEL\",\"state\":\"PR\",\"highlighted\":1,\"slug\":\"taina-lazarini-oliveira\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2025-09-02T14:11:54.000+00:00\",\"updated_at\":\"2025-09-02T14:13:43.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":39,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"Carlos Augusto Fidelis Junior\",\"legend\":\"APROVADO 2x\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cltxe5718001qvmqn48un57cp.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cltxe56x2001pvmqnatvybaih.webp\",\"video\":\"8MisEjDL3N8\",\"message\":null,\"phone\":null,\"instagram\":null,\"city\":null,\"state\":null,\"highlighted\":1,\"slug\":\"carlos-augusto-fidelis-junior\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-03-18T20:21:14.000+00:00\",\"updated_at\":\"2024-03-18T20:21:14.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":4,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"Tati Pauli\",\"legend\":\"Policial Penal Federal\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cltxfw29k003yhjqn45fnbaet.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cltxfw2c0003zhjqn3pbr6oty.webp\",\"video\":\"_CcswEjjkpY\",\"message\":\"\",\"phone\":null,\"instagram\":null,\"city\":null,\"state\":null,\"highlighted\":1,\"slug\":\"tati-pauli\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-02-01T00:00:00.000+00:00\",\"updated_at\":\"2026-02-07T16:45:02.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":37,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"Raquel Laurtert Kataoka\",\"legend\":\"Polícia Federal\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cltxdvtg7001bvmqn2zaz15eg.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cltxdvtjh001cvmqncqc70jzk.webp\",\"video\":\"7X3vrXq9Ywk\",\"message\":\"\u003cp\u003eRaquel, enfrentando problemas com outros cursos, pois o material era extenso e não se adequava ao seu tempo disponível, já que trabalhava e cuidava do filho. Ao buscar alternativas, descobriu o Focus Concursos no Facebook, destacando a acessibilidade do preço e a compatibilidade com sua rotina.\u003c/p\u003e\u003cp\u003eOptou por adquirir o curso completo, realizando todos os exercícios. A aprovação veio após três meses de estudo, mesmo com o adiamento da prova devido ao contexto da pandemia. Destaca a importância do Focus Concursos em fornecer material relevante para a prova e sentir-se como se estivesse \\\"vivendo um sonho\\\".\u003c/p\u003e\",\"phone\":null,\"instagram\":null,\"city\":null,\"state\":null,\"highlighted\":1,\"slug\":\"raquel-laurtert-kataoka-2\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-02-01T00:00:00.000+00:00\",\"updated_at\":\"2024-03-18T20:13:57.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":35,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"Karin Schons Adam\",\"legend\":\"TRT 11\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cltxds0xe0012vmqn8mofe5sq.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cltxds0qv0011vmqn2qnl03km.webp\",\"video\":\"3xSiMbKCTRE\",\"message\":null,\"phone\":null,\"instagram\":null,\"city\":null,\"state\":null,\"highlighted\":1,\"slug\":\"karin-schons-adam\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-03-18T20:11:00.000+00:00\",\"updated_at\":\"2024-03-18T20:11:00.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":26,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"Isabela F. Dias dos Santos\",\"legend\":\"TSE Unificado\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cmf2n7k09000vqiqn7p8t34ln.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cmf2n9g3s000xqiqn4bi51vo2.webp\",\"video\":\"OTGMbwZTwKE\",\"message\":null,\"phone\":null,\"instagram\":null,\"city\":null,\"state\":null,\"highlighted\":1,\"slug\":\"bom-dia-concurseiro-aprovado\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-02-01T00:00:00.000+00:00\",\"updated_at\":\"2025-09-02T14:29:09.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":25,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"Marcos Chibiaqui\",\"legend\":\"DEAP SC\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cltxfmw3c0037hjqnazxd6pdt.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cltxfmw800038hjqn76nwh5pc.webp\",\"video\":\"6gFow46fQjg\",\"message\":\"\u003cp\u003eDesde o início da minha jornada nos concursos públicos, em 2017, o Focus Concursos tem sido meu companheiro. A didática do curso me conquistou e continua sendo parte fundamental na minha batalha. Recentemente, participei do concurso do DF, cujo resultado estou aguardando ansiosamente.\u003c/p\u003e\u003cp\u003eDestaco a importância do Focus, principalmente para quem, como eu, teve uma base de estudos no ensino médio. Foi preciso começar praticamente do zero no português, e o Focus foi essencial nesse processo. Vale ressaltar a qualidade dos professores e do material oferecido, além do excelente custo-benefício.\u003c/p\u003e\u003cp\u003eMinha motivação para seguir firme nos estudos está na busca pela estabilidade para minha família e na realização profissional. O Focus, sem dúvida, atende todas as minhas necessidades, proporcionando cursos alinhados ao nível de concursos que venho estudando.\u003c/p\u003e\",\"phone\":null,\"instagram\":null,\"city\":null,\"state\":null,\"highlighted\":1,\"slug\":\"marcos-chibiaqui\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-02-01T00:00:00.000+00:00\",\"updated_at\":\"2024-03-18T21:03:00.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":20,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"Rodrigo e Daniel\",\"legend\":\"Polícia Federal 2014\",\"photo\":null,\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cltxfuvbb003rhjqndk77457e.webp\",\"video\":\"MlPqRyFD3Fo\",\"message\":\"$30\",\"phone\":null,\"instagram\":null,\"city\":null,\"state\":null,\"highlighted\":1,\"slug\":\"rodrigo-e-daniel\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-02-28T14:10:19.000+00:00\",\"updated_at\":\"2024-03-18T21:09:12.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":9,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"Jean Carlos\",\"legend\":\"TJSP, PCMS, PMSC, PCSP, PPMS e PPPSC\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cltxfgk4h002mhjqnb6r17zxw.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cltxfgk8t002nhjqnhv5eg4nc.webp\",\"video\":\"D-ttwg55lEo\",\"message\":\"$31\",\"phone\":null,\"instagram\":null,\"city\":null,\"state\":null,\"highlighted\":1,\"slug\":\"jean-carlos\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-02-28T14:10:19.000+00:00\",\"updated_at\":\"2024-03-18T20:58:04.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":8,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"João Pedro Tércio Leite Souza\",\"legend\":\"Polícia Militar - BA\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cltxfh85o002qhjqn52am8ous.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cltxfh892002rhjqn3efcc8c7.webp\",\"video\":\"o_cFEpnX_rc\",\"message\":\"\u003cp\u003eNo meu processo de preparação, destaco a importância não apenas do ensino médio e do conteúdo, mas também da inteligência emocional e do planejamento para execução. Enfatizo que esses aspectos são mais cruciais do que simplesmente acumular informações. O método do Focus Concursos, que aborda a fixação de conteúdo e o planejamento, é fundamental e demanda dedicação. Muitas pessoas subestimam a relevância desse aspecto na preparação, o que percebo nas lives. A necessidade de um planejamento é evidente, e o Focus está no caminho certo ao direcionar as pessoas, promovendo a democratização do conhecimento. O método foco é a melhor abordagem para guiar os estudantes nesse processo.\u003c/p\u003e\",\"phone\":null,\"instagram\":null,\"city\":null,\"state\":\"BA\",\"highlighted\":1,\"slug\":\"joao-pedro-tercio-leite-souza\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-02-28T14:10:19.000+00:00\",\"updated_at\":\"2024-03-18T20:58:35.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":7,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"Carlos Rodrigo Dias de Oliveira\",\"legend\":\"Aprovado PMSP\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cmf2nnubz001hqiqn7pe04wea.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cmf4dacs400ititqndwya26sg.webp\",\"video\":\"POPSQMHxyHU\",\"message\":\"\u003cp\u003e...\u003c/p\u003e\",\"phone\":null,\"instagram\":null,\"city\":\"São Paulo\",\"state\":\"SP\",\"highlighted\":1,\"slug\":\"rodrigo-pinheiro\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-02-28T14:10:19.000+00:00\",\"updated_at\":\"2025-09-03T19:25:28.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":6,\"institution_id\":4,\"user_id\":null,\"priority\":\"3\",\"position\":1,\"name\":\"Carla Barreto\",\"legend\":\"Classificados na PF\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cltxffd3e002ehjqna5k8frg9.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cltxffd8f002fhjqnbnae4kwj.webp\",\"video\":\"hBGPrZUAHmU\",\"message\":\"\u003cp\u003eFormei-me em 2013 e, desde então, tinha o desejo de estudar para concursos. Conheci o Focus e comecei a estudar, mas inicialmente, não tinha uma rotina definida e não sabia como estudar corretamente. Meu primeiro concurso foi o INSS em 2015, no qual não obtive aprovação. Após um período sem estudar, retomei os estudos com o apoio do Focus, que foi essencial para manter uma rotina. O curso presencial e o direcionamento dos professores foram fundamentais para me manter motivada e com um direcionamento claro. Tive outras aprovações, mas a PF sempre foi um grande sonho, e é muito gratificante alcançar essa conquista. Agora, a meta é manter o foco para as próximas etapas.\u003c/p\u003e\",\"phone\":null,\"instagram\":null,\"city\":null,\"state\":null,\"highlighted\":1,\"slug\":\"carla-barreto\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-02-01T00:00:00.000+00:00\",\"updated_at\":\"2024-03-18T20:57:08.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]},{\"id\":34,\"institution_id\":4,\"user_id\":null,\"priority\":\"4\",\"position\":1,\"name\":\"Ricardo Vieira\",\"legend\":\"Aprovado Policial Penal Federal\",\"photo\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/photo/cltxdlyk2000rvmqnblak94gt.webp\",\"image\":\"https://s3.us-east-1.amazonaws.com/arquivos.grupofocus.com.br/admin/institution/image/cltxdlyms000svmqnb2dv6axw.webp\",\"video\":\"gkjgkLdsmHQ\",\"message\":\"\",\"phone\":null,\"instagram\":null,\"city\":null,\"state\":null,\"highlighted\":1,\"slug\":\"ricardo-vieira-1\",\"office\":null,\"is_active\":1,\"image_usage_expiration_date\":null,\"created_at\":\"2024-03-18T20:05:38.000+00:00\",\"updated_at\":\"2026-02-07T16:44:32.000+00:00\",\"deleted_at_unix\":0,\"tags\":[{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0},{\"id\":3,\"institution_id\":4,\"name\":\"PRINCIPAL\",\"created_at\":\"2025-09-02T23:35:14.000+00:00\",\"updated_at\":\"2025-09-02T23:35:14.000+00:00\",\"deleted_at_unix\":0}]}],\"title\":\"Depoimento de nossos alunos\",\"subtitle\":\"$undefined\",\"fallbackImage\":\"https://s3.us-east-1.amazonaws.com/s3.grupofocus.com.br/admin/institution/defaultImageProduct/cmggvcfqu0036c2qn53i66zh0.webp\"}]]\n"])</script><script>self.__next_f.push([1,"32:I[82085,[\"66711\",\"static/chunks/8e1d74a4-df0199328e47a178.js\",\"85105\",\"static/chunks/0e5ce63c-a1ecb5a6f4ebd24d.js\",\"6446\",\"static/chunks/53c13509-17f96d50f6536e7d.js\",\"55271\",\"static/chunks/619edb50-8c144cfce5f5d982.js\",\"48087\",\"static/chunks/0e762574-074f5991039d779e.js\",\"18720\",\"static/chunks/18720-e3c03955